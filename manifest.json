{
  "manifest_version": 3,
  "name": "Meta Ad Library Video Downloader",
  "version": "1.5.0",
  "description": "Download videos and images from Meta Ad Library in HD/SD/highest-res, auto-load all media, sort into language folders, and export ad copy (headline + primary text).",
  "permissions": ["activeTab", "downloads", "storage"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://*.fbcdn.net/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/ads/library/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
